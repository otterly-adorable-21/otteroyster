# Copy to .env and fill in. Never commit the real .env.

# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register commands instantly in one test server instead of globally
DISCORD_DEV_GUILD_ID=

# Web server
PORT=8787
# Public URL of the website (used in bot messages)
SITE_URL=https://otteroyster.online
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=https://otteroyster.online,https://www.otteroyster.online
# Where the SQLite database lives (use a persistent disk in production)
DB_PATH=./data/otteroyster.db
